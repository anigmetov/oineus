    @property
    def max_dim(self) -> int: ...

class KICRDiagrams:
    """Differentiable kernel/image/cokernel diagrams of an inclusion L -> K."""
    reduction: KerImCokReduced
    def __init__(
        self,
        K: DiffFiltration,
        L: DiffFiltration | Filtration,
        *,
        kernel: bool = True,
        image: bool = True,
        cokernel: bool = True,
        include_zero_persistence: bool = False,
        include_inf_points: bool = False,
        n_threads: int = 1,
    ) -> None: ...
    @property
    def kernel(self) -> KICRFamilyDiagrams: ...
    @property
    def image(self) -> KICRFamilyDiagrams: ...
    @property
    def cokernel(self) -> KICRFamilyDiagrams: ...
    @property
    def families(self) -> tuple[str, ...]: ...

