class DiffFiltration:
    """Autograd-aware wrapper pairing a C++ Filtration with a differentiable values tensor."""
    under_fil: Filtration
    values: Any
    def __init__(self, fil: Filtration, values: Any) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __getattr__(self, name: str) -> Any: ...

class TopologyOptimizer:
    """Differentiable-pipeline wrapper dispatching to the C++ TopologyOptimizer."""
    under_opt: Any
    under_fil: Filtration
    def __init__(
        self,
        fil: DiffFiltration | Filtration,
        *,
        with_crit_sets: bool = True,
        dims_to_restore_elz: Sequence[int] | None = None,
        n_threads: int = 1,
        u_strategy: UStrategy | None = None,
    ) -> None: ...
    def compute_diagram(self, include_inf_points: bool) -> Diagrams: ...
    def simplify(self, epsilon: float, strategy: DenoiseStrategy, dim: int) -> IndicesValues: ...
    def get_nth_persistence(self, dim: int, n: int) -> float: ...
    def match(
        self,
        template_dgm: Any,
        dim: int,
        wasserstein_q: float = 1.0,
        wasserstein_delta: float = 0.01,
        return_wasserstein_distance: bool = False,
        dualize: bool | None = None,
        internal_p: float = -1.0,
    ) -> Any: ...
    @property
    def homology_decomposition(self) -> Decomposition: ...
    @property
    def cohomology_decomposition(self) -> Decomposition: ...
    def homology_decomposition_ref(self) -> Decomposition: ...
    def cohomology_decomposition_ref(self) -> Decomposition: ...
    def ensure_hom_built(self) -> None: ...
    def ensure_coh_built(self) -> None: ...
    @property
    def is_hom_built(self) -> bool: ...
    @property
    def is_coh_built(self) -> bool: ...
    def ensure_hom_reduced(self) -> None: ...
    def ensure_coh_reduced(self) -> None: ...
    def ensure_has_u_hom(self, dim: int, rows_fil: Sequence[int], bounds: Sequence[int]) -> None: ...
    def ensure_has_u_coh(self, dim: int, rows_fil: Sequence[int], bounds: Sequence[int]) -> None: ...
    def reduce_all(self) -> None: ...
    def update(self, new_values: Sequence[float], n_threads: int = 1) -> None: ...
    def crit_sets_apply(self, indices: Sequence[int], values: Sequence[float], strategy: ConflictStrategy) -> IndicesValues: ...
    def crit_sets_apply_typed(
        self,
        birth_indices: Sequence[int],
        birth_values: Sequence[float],
        death_indices: Sequence[int],
        death_values: Sequence[float],
        strategy: ConflictStrategy,
    ) -> IndicesValues: ...
    def singleton(self, index: int, value: float) -> Any: ...
    def singletons(self, indices: Sequence[int], values: Sequence[float]) -> Any: ...
    def combine_loss(self, critical_sets: Any, strategy: ConflictStrategy) -> IndicesValues: ...
    def increase_death(self, negative_simplex_idx: int) -> list[int]: ...
    def decrease_death(self, negative_simplex_idx: int) -> list[int]: ...
    def increase_birth(self, positive_simplex_idx: int) -> list[int]: ...
    def decrease_birth(self, positive_simplex_idx: int) -> list[int]: ...

class PersistenceDiagrams:
    """Container for differentiable persistence diagrams across dimensions."""
    def __init__(
        self,
        fil: DiffFiltration,
        *,
        dualize: bool | None,
        include_inf_points: bool,
        gradient_method: str,
        step_size: float,
        conflict_strategy: str | ConflictStrategy,
        n_threads: int | None,
        u_strategy: str | UStrategy | None,
        dims_to_backprop: Sequence[int] | None,
    ) -> None: ...
    def __getitem__(self, dim: int) -> Any: ...
    def __contains__(self, dim: int) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[int]: ...
    def keys(self) -> Any: ...
    def values(self) -> Any: ...
    def items(self) -> Any: ...
    def in_dimension(self, dim: int) -> Any: ...
    @property
    def max_dim(self) -> int: ...

class KICRFamilyDiagrams:
    """Differentiable diagrams of one KICR family (kernel, image, or cokernel)."""
    family: str
    def __getitem__(self, dim: int) -> Any: ...
    def __contains__(self, dim: int) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[int]: ...
    def keys(self) -> Any: ...
    def values(self) -> Any: ...
    def items(self) -> Any: ...
